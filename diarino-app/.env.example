# Copy this file to .env and fill in real values — .env is git-ignored,
# this template isn't. Only EXPO_PUBLIC_-prefixed vars get inlined into
# the app bundle, so these are the only client-side ones. Everything
# YouTube-related that must stay secret (GOOGLE_CLIENT_SECRET) is a
# Supabase Edge Function secret instead — set via
# `supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...`,
# never put it in this file. See docs/YOUTUBE_LIVE_MIGRATION_GUIDE.md.

# Get these from Supabase Dashboard → Project Settings → API, for
# whichever project you're pointing this local run at (dev/preview vs.
# production use different projects — see README.md section 2).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The OAuth 2.0 "Web application" Client ID from Google Cloud Console
# (Credentials → Create Credentials → OAuth client ID → Web application).
# This is the client id BOTH the native Google Sign-In SDK (as
# `webClientId`, to get an offline-access serverAuthCode) and the web
# build (Google Identity Services) use — it is safe to ship publicly,
# unlike the client *secret*, which never appears on the client at all.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
